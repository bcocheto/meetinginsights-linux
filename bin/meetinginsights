#!/bin/bash
# meetinginsights — MeetingInsights: AI Note Taker.
#
#   meetinginsights start "Sprint planning" [--client NAME] [--focus "what matters"]
#                                             begin recording (microphone + system audio)
#   meetinginsights client [list|show|set|rm] NAME [terms...]   per-client glossary for names and terms
#   meetinginsights stop [--capture-only]     stop, transcribe, write notes (--capture-only: just stop
#                                             recording; finish later with: meetinginsights finish <name>)
#   meetinginsights status                    show whether a recording is running
#   meetinginsights recover [--list]          finish a recording that was cut short and process any left without notes
#   meetinginsights notes <transcript.txt>    (re)generate notes from a transcript
#   meetinginsights setup                     fetch the speech and language models
#   meetinginsights language [system|auto|pt|en|...]   show or set the spoken language
#   meetinginsights config [key [value]]     show or set whisper_model, notes_provider, whisper_device
#   meetinginsights import <audio|video> [title] [--client N] [--focus T]   transcribe an existing file and write the notes
#   meetinginsights reprocess <name> [--notes-only] [--client N] [--focus T]    transcribe again and rewrite the notes
#   meetinginsights rename <name> <new title>          rename a meeting
#   meetinginsights export <name> <md|docx|pdf> [file] [--no-transcript]   export notes + transcript
#   meetinginsights delete <name>                      delete a meeting's notes, transcript and audio
#
# Nothing leaves the machine: audio is captured with PulseAudio, transcribed by
# faster-whisper and summarised by a small local GGUF model via llama.cpp. There
# is no network call at run time and no API key anywhere.
#
# Your microphone is recorded to the LEFT channel and everything you hear to the
# RIGHT, so who-said-what comes from audio routing rather than a guess.

set -uo pipefail
# Recordings and notes are private to this user, and nothing here phones home.
umask 077
export HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1

# Find the library directory, whichever layout we are running from:
# an explicit prefix, a system install, a ~/.local install, or the source tree.
_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX=""
for _c in "${MEETINGINSIGHTS_PREFIX:-}" \
          "$_bin_dir/../share/meetinginsights" \
          "/usr/share/meetinginsights" \
          "/usr/local/share/meetinginsights" \
          "$_bin_dir/.."; do
    [[ -n "$_c" && -f "$_c/lib/notes_local.py" ]] && { PREFIX="$(cd "$_c" && pwd)"; break; }
done
[[ -n "$PREFIX" ]] || { echo "meetinginsights: cannot locate its lib/ directory" >&2; exit 1; }

DATA_DIR="${MEETINGINSIGHTS_HOME:-$HOME/.local/share/meetinginsights}"
OUT_DIR="${MEETINGINSIGHTS_OUT:-$HOME/MeetingNotes}"
# Settings live in ~/.config/meetinginsights/config as key=value lines. Environment
# variables win over the file; see `meetinginsights config`.
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/meetinginsights/config"
cfg_get() { # cfg_get <key> <default>
    local v=""
    [[ -f "$CONFIG_FILE" ]] && v=$(sed -n "s/^$1=//p" "$CONFIG_FILE" | tail -n1)
    echo "${v:-$2}"
}
# "small" is multilingual; "small.en" is English-only; "medium" is more accurate but slower.
# Default: the faster "turbo" model when the GPU libraries are installed, else "small".
_default_model=small
compgen -G "${MEETINGINSIGHTS_HOME:-$HOME/.local/share/meetinginsights}/venv/lib/python*/site-packages/nvidia/cublas" >/dev/null 2>&1 \
    && [[ "${MEETINGINSIGHTS_DEVICE:-$(cfg_get whisper_device auto)}" != cpu ]] && _default_model=large-v3-turbo
WHISPER_MODEL="${MEETINGINSIGHTS_WHISPER_MODEL:-$(cfg_get whisper_model "$_default_model")}"
# Processor for speech recognition: auto (GPU when one is usable) or cpu.
export MEETINGINSIGHTS_DEVICE="${MEETINGINSIGHTS_DEVICE:-$(cfg_get whisper_device auto)}"
# Speech options (see `meetinginsights config`)
export MEETINGINSIGHTS_DIARIZE="${MEETINGINSIGHTS_DIARIZE:-$(cfg_get diarize on)}"
export MEETINGINSIGHTS_SPEAKERS="${MEETINGINSIGHTS_SPEAKERS:-$(cfg_get speakers 0)}"
export MEETINGINSIGHTS_PROMPT="${MEETINGINSIGHTS_PROMPT:-$(cfg_get prompt "")}"
BASE_PROMPT="$MEETINGINSIGHTS_PROMPT"   # the per-meeting glossary is added on top of this
export MEETINGINSIGHTS_BEAM="${MEETINGINSIGHTS_BEAM:-$(cfg_get beam 5)}"
export MEETINGINSIGHTS_THREADS="${MEETINGINSIGHTS_THREADS:-$(cfg_get threads 0)}"
export MEETINGINSIGHTS_NORMALIZE="${MEETINGINSIGHTS_NORMALIZE:-$(cfg_get normalize off)}"
# Who writes the notes: local (llama.cpp, nothing leaves the machine), claude-code or gemini-cli.
export MEETINGINSIGHTS_NOTES_PROVIDER="${MEETINGINSIGHTS_NOTES_PROVIDER:-$(cfg_get notes_provider local)}"
# Spoken language: "system" (follow the OS locale), "auto" (detect), or a code (pt, en, ...).
# Order: MEETINGINSIGHTS_LANGUAGE env > ~/.config/meetinginsights/language > system.
LANG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/meetinginsights/language"
resolve_language() {
    local l="${MEETINGINSIGHTS_LANGUAGE:-}"
    [[ -z "$l" && -s "$LANG_FILE" ]] && l="$(head -n1 "$LANG_FILE" | tr -d '[:space:]')"
    l="${l:-system}"
    if [[ "$l" == system ]]; then
        l="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
        l="${l%%[_.@]*}"
        case "$l" in ""|C|POSIX) l=auto ;; esac
    fi
    echo "${l,,}"
}
export MEETINGINSIGHTS_LANGUAGE="$(resolve_language)"
# Size of the local model that writes the summaries: small (0.5B, 0.5 GB, any machine)
# or medium (3B, 2 GB, noticeably better prose; needs ~3 GB of free RAM).
export MEETINGINSIGHTS_NOTES_MODEL="${MEETINGINSIGHTS_NOTES_MODEL:-$(cfg_get notes_model small)}"
case "$MEETINGINSIGHTS_NOTES_MODEL" in
    medium) _llm_file=qwen2.5-3b-instruct-q4_k_m.gguf; _llm_repo=Qwen2.5-3B-Instruct-GGUF ;;
    *)      _llm_file=qwen2.5-0.5b-instruct-q4_k_m.gguf; _llm_repo=Qwen2.5-0.5B-Instruct-GGUF ;;
esac
LLM_MODEL="${MEETINGINSIGHTS_LLM_MODEL:-$DATA_DIR/models/$_llm_file}"
LLM_URL="https://huggingface.co/Qwen/$_llm_repo/resolve/main/$_llm_file"
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    pt*) _you=Você; _them=Participantes ;;
    *)   _you=You;  _them=Participants ;;
esac
YOU_LABEL="${MEETINGINSIGHTS_YOU:-$_you}"
THEM_LABEL="${MEETINGINSIGHTS_THEM:-$_them}"
PY="${MEETINGINSIGHTS_PYTHON:-$DATA_DIR/venv/bin/python}"
LLAMA="${MEETINGINSIGHTS_LLAMA:-}"
if [[ -z "$LLAMA" ]]; then
    for _l in "$DATA_DIR/llama/llama" "/usr/lib/meetinginsights/llama/llama" \
              "/usr/local/lib/meetinginsights/llama/llama"; do
        [[ -x "$_l" ]] && { LLAMA="$_l"; break; }
    done
    LLAMA="${LLAMA:-$DATA_DIR/llama/llama}"
fi
STATE="$DATA_DIR/current"

die()  { echo "meetinginsights: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

default_monitor() {
    local sink; sink=$(pactl get-default-sink 2>/dev/null)
    [[ -n "$sink" ]] && echo "${sink}.monitor"
}

check_ready() {
    [[ -x "$PY" ]]        || die "python environment missing — run: meetinginsights setup"
    [[ -x "$LLAMA" ]]     || die "llama.cpp runtime missing — run: meetinginsights setup"
    [[ -s "$LLM_MODEL" ]] || die "language model missing — run: meetinginsights setup"
}

# Emits "PCT|<0-100>" and "STEP|<text>" lines when --porcelain is passed, so the
# desktop app can render a progress bar instead of sending people to a terminal.
cmd_setup() {
    local porcelain=0
    [[ "${1:-}" == "--porcelain" ]] && porcelain=1
    _step() { if (( porcelain )); then echo "STEP|$1"; else echo "$1"; fi; }
    _pct()  { (( porcelain )) && echo "PCT|$1"; }

    mkdir -p "$DATA_DIR/models" "$OUT_DIR"

    # Only one setup at a time: a second run (GUI button pressed twice, or CLI
    # alongside the app) would fight over the same partial download.
    exec 9>"$DATA_DIR/.setup.lock"
    if ! flock -n 9; then
        echo "ERR|setup is already running in another window"
        return 1
    fi

    if [[ ! -x "$PY" ]]; then
        _step "Creating the Python environment"; _pct 2
        # faster-whisper pulls in tokenizers, which has no working wheel for
        # Python 3.8 — and 3.8 is what `python3` still is on Ubuntu 20.04, so
        # picking the plain interpreter silently builds a broken environment.
        local _py=""
        for _c in python3.13 python3.12 python3.11 python3.10 python3.9; do
            command -v "$_c" >/dev/null 2>&1 && { _py="$_c"; break; }
        done
        if [[ -z "$_py" ]] && command -v python3 >/dev/null 2>&1; then
            python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null \
                && _py=python3
        fi
        if [[ -z "$_py" ]]; then
            echo "ERR|needs Python 3.9 or newer; found $(python3 -V 2>&1). On Ubuntu 20.04: sudo apt install python3.11 python3.11-venv"
            return 1
        fi
        _step "Creating the Python environment ($_py)"
        "$_py" -m venv "$DATA_DIR/venv" >/dev/null 2>&1 \
            || { echo "ERR|could not create the environment (try: sudo apt install ${_py}-venv)"; return 1; }
        _pct 8
        _step "Installing speech recognition (a few minutes)"
        "$DATA_DIR/venv/bin/pip" install -q --upgrade pip >/dev/null 2>&1
        "$DATA_DIR/venv/bin/pip" install -q faster-whisper python-docx reportlab sherpa-onnx >/dev/null 2>&1 \
            || { echo "ERR|could not install faster-whisper"; return 1; }
        # NVIDIA GPU present: add the CUDA libraries (inside this environment only) for faster transcription
        command -v nvidia-smi >/dev/null 2>&1 && \
            "$DATA_DIR/venv/bin/pip" install -q nvidia-cublas-cu12 nvidia-cudnn-cu12 >/dev/null 2>&1 || true
        _pct 35
    else
        _step "Python environment ready"; _pct 35
    fi

    # Telling voices apart on the call (optional: a failure here never blocks setup)
    if ! "$PY" -c 'import sherpa_onnx' 2>/dev/null; then
        _step "Installing speaker recognition"
        "$DATA_DIR/venv/bin/pip" install -q sherpa-onnx >/dev/null 2>&1 || true
    fi
    if [[ ! -f "$DATA_DIR/models/diarization/speaker-embedding.onnx" ]]; then
        _step "Downloading the speaker recognition models (about 46 MB)"
        "$PY" "$PREFIX/lib/diarize.py" --fetch >/dev/null 2>&1 || true
    fi

    if [[ ! -s "$LLM_MODEL" ]]; then
        _step "Downloading the language model (about 470 MB)"
        rm -f "$LLM_MODEL.part"
        "$PY" - "$LLM_URL" "$LLM_MODEL.part" "$porcelain" <<'PYEOF' || { echo "ERR|model download failed"; rm -f "$LLM_MODEL.part"; return 1; }
import os, sys, time, urllib.request

url, dest, porcelain = sys.argv[1], sys.argv[2], sys.argv[3] == "1"


def emit(pct, last):
    if porcelain and pct != last:
        print(f"PCT|{pct}", flush=True)
    return pct


for attempt in range(3):
    have = os.path.getsize(dest) if os.path.exists(dest) else 0
    req = urllib.request.Request(url)
    if have:                                   # resume rather than restart
        req.add_header("Range", f"bytes={have}-")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            total = int(r.headers.get("Content-Length") or 0)
            if r.status == 206:
                total += have                  # partial response counts only the remainder
            elif have:
                have = 0                       # server ignored Range; start over
            mode = "ab" if have else "wb"
            last = -1
            with open(dest, mode) as f:
                while chunk := r.read(1 << 20):
                    f.write(chunk); have += len(chunk)
                    if total:
                        # this download spans 35..85% of the overall bar
                        last = emit(35 + int(have * 50 / total), last)
        # A short read raises no error, so the size is the only thing that proves
        # the file is whole. Without this check a dropped connection installs a
        # truncated model that still starts with the GGUF magic bytes.
        if total and os.path.getsize(dest) != total:
            raise IOError(f"incomplete: {os.path.getsize(dest)} of {total} bytes")
        sys.exit(0)
    except Exception as e:                      # noqa: BLE001 - retried below
        print(f"STEP|Download interrupted ({e}); retrying", flush=True)
        time.sleep(2 * (attempt + 1))

sys.exit(1)
PYEOF
        mv "$LLM_MODEL.part" "$LLM_MODEL"
    else
        _step "Language model present"
    fi
    _pct 85

    _step "Fetching the speech model"
    "$PY" - "$WHISPER_MODEL" >/dev/null 2>&1 <<'PYEOF' || true
import sys
from faster_whisper import WhisperModel
WhisperModel(sys.argv[1], device="cpu", compute_type="int8")
PYEOF
    if ! "$PY" -c "import faster_whisper" >/dev/null 2>&1; then
        echo "ERR|the Python environment is not usable (faster-whisper failed to import)"
        return 1
    fi
    _pct 100
    _step "Setup complete"
    (( porcelain )) && echo "DONE|"
    return 0
}

# --- per-meeting context: a client (with a saved glossary) and a focus for the notes ---
CLIENTS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/meetinginsights/clients"
_slug() { echo "$1" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//'; }

M_CLIENT=""; M_FOCUS=""; M_CLIENT_SET=0; M_FOCUS_SET=0; POS=()
_parse_meta_flags() { # splits --client/--focus from the other arguments (left in POS)
    POS=(); M_CLIENT=""; M_FOCUS=""; M_CLIENT_SET=0; M_FOCUS_SET=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --client) [[ $# -ge 2 ]] || die "--client needs a name"; M_CLIENT="$2"; M_CLIENT_SET=1; shift 2 ;;
            --focus)  [[ $# -ge 2 ]] || die "--focus needs a text";  M_FOCUS="$2";  M_FOCUS_SET=1;  shift 2 ;;
            *) POS+=("$1"); shift ;;
        esac
    done
    M_CLIENT="$(echo "$M_CLIENT" | tr '\n\r' '  ')"; M_CLIENT="${M_CLIENT:0:80}"
    M_FOCUS="$(echo "$M_FOCUS" | tr '\n\r' '  ')";   M_FOCUS="${M_FOCUS:0:500}"
}
_meta_load() { # _meta_load <base> : reads <base>.meta into M_CLIENT / M_FOCUS
    M_CLIENT=""; M_FOCUS=""
    [[ -f "$1.meta" ]] || return 0
    M_CLIENT=$(sed -n 's/^client=//p' "$1.meta" | head -n1)
    M_FOCUS=$(sed -n 's/^focus=//p' "$1.meta" | head -n1)
}
_meta_save() { # _meta_save <base>
    if [[ -n "$M_CLIENT$M_FOCUS" ]]; then
        { [[ -z "$M_CLIENT" ]] || echo "client=$M_CLIENT"; [[ -z "$M_FOCUS" ]] || echo "focus=$M_FOCUS"; } > "$1.meta"
    else
        rm -f "$1.meta"
    fi
}
_meta_env() { # exports the focus/glossary and adds the glossary to the speech prompt
    local gloss="" f
    if [[ -n "$M_CLIENT" ]]; then
        f="$CLIENTS_DIR/$(_slug "$M_CLIENT").txt"
        [[ -f "$f" ]] && gloss="$(sed -n '2,$p' "$f" | tr '\n\r' '  ')"
    fi
    export MEETINGINSIGHTS_CLIENT="$M_CLIENT" MEETINGINSIGHTS_FOCUS="$M_FOCUS" MEETINGINSIGHTS_GLOSSARY="${gloss:0:400}"
    MEETINGINSIGHTS_PROMPT="$(printf '%s %s' "${gloss:0:400}" "$BASE_PROMPT" | sed 's/^ *//;s/ *$//')"
    export MEETINGINSIGHTS_PROMPT
}

cmd_client() { # client [list | show <name> | set <name> <terms...> | rm <name>]
    local sub="${1:-list}"; shift || true
    local name="${1:-}" f
    case "$sub" in
        list) for f in "$CLIENTS_DIR"/*.txt; do [[ -f "$f" ]] && head -n1 "$f"; done; return 0 ;;
        show|rm|set) [[ -n "$name" ]] || die "usage: meetinginsights client $sub <name>${sub/#set/ <terms...>}" ;;
        *) die "usage: meetinginsights client [list|show <name>|set <name> <terms...>|rm <name>]" ;;
    esac
    shift
    f="$CLIENTS_DIR/$(_slug "$name").txt"
    [[ -n "$(_slug "$name")" ]] || die "invalid client name: $name"
    case "$sub" in
        show) [[ -f "$f" ]] || die "no such client: $name"; sed -n '2,$p' "$f" ;;
        rm)   [[ -f "$f" ]] || die "no such client: $name"; rm -f "$f"; echo "Removed client: $name" ;;
        set)  local terms="$*"
              terms="$(echo "$terms" | tr '\n\r' '  ')"
              mkdir -p "$CLIENTS_DIR"
              printf '%s\n%s\n' "${name:0:80}" "${terms:0:400}" > "$f"
              echo "Saved glossary for: $name" ;;
    esac
}

cmd_start() {
    if [[ -f "$STATE" ]]; then
        _rec_alive && die "already recording (see: meetinginsights status)"
        die "an earlier recording was interrupted; finish it first with: meetinginsights recover"
    fi
    need parec; need ffmpeg; check_ready
    _parse_meta_flags "$@"
    local title="${POS[0]:-meeting}" slug ts base
    slug=$(echo "$title" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')
    ts=$(date +%Y-%m-%d_%H-%M)
    base="$DATA_DIR/rec/${ts}_${slug}"
    mkdir -p "$DATA_DIR/rec" "$OUT_DIR"
    chmod 700 "$DATA_DIR" "$DATA_DIR/rec" "$OUT_DIR" 2>/dev/null || true

    local mon; mon=$(default_monitor)
    [[ -n "$mon" ]] || die "could not find the default audio sink (is PulseAudio or PipeWire running?)"

    # Resolve the microphone by name rather than passing @DEFAULT_SOURCE@ blind:
    # if the default input is itself a monitor, both captures record the same
    # thing and every turn gets attributed twice under two different names.
    local src; src=$(pactl get-default-source 2>/dev/null)
    [[ -n "$src" ]] || die "could not determine the default audio input"
    if [[ "$src" == *.monitor ]]; then
        local real; real=$(pactl list short sources 2>/dev/null | grep -v '\.monitor' | awk 'NR==1{print $2}')
        if [[ -n "$real" ]]; then
            echo "Note: the default input is a monitor of the speakers; using $real instead."
            src="$real"
        else
            die "the default audio input is a monitor, not a microphone, and no real input was found — pick one in Sound settings"
        fi
    fi
    if [[ "$src" == "$mon" ]]; then
        die "microphone and system capture resolve to the same device ($src) — pick a real input in Sound settings"
    fi
    printf 'mic:    %s\nsystem: %s\n' "$src" "$mon" > "$DATA_DIR/.devices.log"

    parec --device="$src" --format=s16le --rate=16000 --channels=1 \
        --file-format=wav "$base.mic.wav" >/dev/null 2>&1 &
    echo $! > "$DATA_DIR/.mic.pid"
    parec --device="$mon" --format=s16le --rate=16000 --channels=1 \
        --file-format=wav "$base.sys.wav" >/dev/null 2>&1 &
    echo $! > "$DATA_DIR/.sys.pid"

    sleep 1
    kill -0 "$(cat "$DATA_DIR/.mic.pid")" 2>/dev/null || die "microphone capture failed to start"
    kill -0 "$(cat "$DATA_DIR/.sys.pid")" 2>/dev/null || die "system audio capture failed to start"

    _meta_save "$base"; _meta_env
    # transcribe while the meeting runs, so stopping is nearly instant
    if [[ "${MEETINGINSIGHTS_LIVE:-1}" == "1" && -f "$PREFIX/lib/live_transcribe.py" ]]; then
        rm -f "$base.stop" "$base.live.done"
        setsid "$PY" "$PREFIX/lib/live_transcribe.py" "$base" \
            "$WHISPER_MODEL" "$YOU_LABEL" "$THEM_LABEL" \
            >"$DATA_DIR/.live.log" 2>&1 < /dev/null &
        echo $! > "$DATA_DIR/.live.pid"
    fi

    printf '%s\n%s\n%s\n' "$base" "$title" "$(date +%s)" > "$STATE"
    echo "Recording: $title"
    echo "Stop with: meetinginsights stop"
    echo
    echo "Please make sure everyone on the call knows they are being recorded."
}

# Quiet readiness probe: exit 0 when the app can run, 1 when setup is needed.
cmd_ready() {
    [[ -x "$PY" && -x "$LLAMA" && -s "$LLM_MODEL" ]] || return 1
    # a truncated GGUF still carries the magic bytes, so check the size too
    [[ $(stat -c%s "$LLM_MODEL" 2>/dev/null || echo 0) -ge 300000000 ]] || return 1
    [[ "$(head -c4 "$LLM_MODEL" 2>/dev/null)" == "GGUF" ]]
}

cmd_status() {
    [[ -f "$STATE" ]] || { echo "Not recording."; return 0; }
    local base title started
    { read -r base; read -r title; read -r started; } < "$STATE"
    if ! _rec_alive; then
        echo "Interrupted \"$title\" ($(basename "$base")): run meetinginsights recover"; return 0
    fi
    echo "Recording \"$title\" for $(( ($(date +%s) - started) / 60 ))m ($(basename "$base"))"
}


# Split the far-end channel into one label per voice (Participant 1, 2, ...).
_split_voices() { # _split_voices <wav> <txt> <target-label> <prefix>
    [[ "$MEETINGINSIGHTS_DIARIZE" == "on" ]] || return 0
    [[ -f "$DATA_DIR/models/diarization/speaker-embedding.onnx" ]] || return 0
    echo "Telling voices apart..."
    "$PY" "$PREFIX/lib/diarize.py" "$1" "$2" "$3" "$4" "$MEETINGINSIGHTS_SPEAKERS" 2>&1 | grep -E "speakers found|no speaker" || true
}
_voice_prefixes() { # sets _p_part and _p_spk according to the interface language
    case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
        pt*) _p_part=Participante; _p_spk=Falante ;;
        *)   _p_part=Participant;  _p_spk=Speaker ;;
    esac
    export MEETINGINSIGHTS_PREFIX_PART="$_p_part" MEETINGINSIGHTS_PREFIX_SPK="$_p_spk"
}
_voice_prefixes

# A capture process that is really ours (pid files survive crashes and reboots,
# and the number may since belong to something else).
_is_parec() { [[ -n "${1:-}" && -r "/proc/$1/cmdline" ]] && tr '\0' ' ' < "/proc/$1/cmdline" | grep -q parec; }
_rec_alive() { [[ -f "$DATA_DIR/.mic.pid" ]] && _is_parec "$(cat "$DATA_DIR/.mic.pid")"; }

# Join the two capture files into one stereo file (mic left, system right).
_merge_channels() { # _merge_channels <base>
    local base="$1" d1 d2 dmax
    d1=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$base.mic.wav" 2>/dev/null)
    d2=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$base.sys.wav" 2>/dev/null)
    dmax=$(awk -v a="${d1:-0}" -v b="${d2:-0}" 'BEGIN{print (a>b)?a:b}')
    ffmpeg -loglevel error -y -i "$base.mic.wav" -i "$base.sys.wav" \
        -filter_complex "[0:a]apad=whole_dur=$dmax[l];[1:a]apad=whole_dur=$dmax[r];[l][r]join=inputs=2:channel_layout=stereo[a]" \
        -map "[a]" -ar 16000 "$base.wav" 2>&1 | tail -2
    [[ -s "$base.wav" ]] || die "could not merge the two audio channels"

    # Check the merge before throwing the sources away. If both channels carry
    # the same signal the recording is unusable for speaker attribution, and
    # deleting the per-channel files would destroy the only evidence of why.
    if "$PY" "$PREFIX/lib/transcribe.py" --check-channels "$base.wav" 2>/dev/null; then
        rm -f "$base.mic.wav" "$base.sys.wav"
    else
        echo "Warning: both channels captured the same audio, so speakers cannot be" >&2
        echo "told apart. Keeping $(basename "$base").mic.wav and .sys.wav for diagnosis;" >&2
        echo "check the input device in Sound settings." >&2
    fi
}

# What an interrupted session left behind: recordings with audio but no notes.
_pending_names() {
    local f base name cur=""
    [[ -f "$STATE" ]] && cur="$(head -n1 "$STATE")"
    for f in "$DATA_DIR"/rec/*.wav; do
        [[ -f "$f" ]] || continue
        base="${f%.wav}"; name="$(basename "$base")"
        [[ "$name" == *.mic || "$name" == *.sys ]] && continue
        [[ "$base" == "$cur" || -f "$base.nospeech" || -f "$OUT_DIR/$name.md" ]] && continue
        echo "$name"
    done
    for f in "$DATA_DIR"/rec/*.mic.wav; do   # captured, but never merged
        [[ -f "$f" ]] || continue
        base="${f%.mic.wav}"; name="$(basename "$base")"
        [[ "$base" == "$cur" || -s "$base.wav" || ! -f "$base.sys.wav" ]] && continue
        echo "$name"
    done
}

cmd_recover() { # recover [--list]
    local interrupted=0
    [[ -f "$STATE" ]] && ! _rec_alive && interrupted=1
    if [[ "${1:-}" == "--list" ]]; then
        (( interrupted )) && echo "interrupted"
        _pending_names | sed 's/^/pending:/'
        return 0
    fi
    local did=0 name
    if (( interrupted )); then
        echo "Finishing the interrupted recording..."
        cmd_stop || true; did=1
    fi
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        echo "Processing $name..."
        if [[ ! -s "$DATA_DIR/rec/$name.wav" ]]; then
            need ffmpeg; _merge_channels "$DATA_DIR/rec/$name"
        fi
        if [[ -f "$DATA_DIR/rec/$name.job" ]]; then _finish_recording "$name" || true
        else cmd_reprocess "$name" || true; fi
        did=1
    done < <(_pending_names)
    (( did )) || echo "Nothing to recover."
}

cmd_stop() { # stop [--capture-only]
    [[ -f "$STATE" ]] || die "not recording"
    local capture_only=0; [[ "${1:-}" == "--capture-only" ]] && capture_only=1
    local base title started
    { read -r base; read -r title; read -r started; } < "$STATE"
    _meta_load "$base"; _meta_env

    local p f live_pid=""
    for p in mic sys; do
        f="$DATA_DIR/.$p.pid"
        [[ -f "$f" ]] && { _is_parec "$(cat "$f")" && kill "$(cat "$f")" 2>/dev/null; rm -f "$f"; }
    done
    # take the live transcriber's pid now: a new recording may start before we finish
    [[ -f "$DATA_DIR/.live.pid" ]] && { live_pid=$(cat "$DATA_DIR/.live.pid"); rm -f "$DATA_DIR/.live.pid"; }
    sleep 1; rm -f "$STATE"

    local mins=$(( ($(date +%s) - started) / 60 ))
    echo "Stopped after ${mins}m. Merging channels..."
    _merge_channels "$base"
    touch "$base.stop"      # tells the live transcriber to wrap up
    printf '%s\n%s\n%s\n' "$title" "$mins" "$live_pid" > "$base.job"

    if (( capture_only )); then
        echo "Queued: $(basename "$base")"; return 0
    fi
    _finish_recording "$(basename "$base")"
}

# Everything after the capture: wait for the live transcript, tell voices apart, write the notes.
_finish_recording() { # _finish_recording <name>
    local base="$DATA_DIR/rec/$1" title mins live_pid used_live=0
    [[ -f "$base.job" ]] || die "nothing to finish for: $1"
    { read -r title; read -r mins; read -r live_pid; } < "$base.job"
    _meta_load "$base"; _meta_env
    mins="${mins:-?}"

    local waited_on_live=0
    if [[ -n "$live_pid" ]] && kill -0 "$live_pid" 2>/dev/null; then
        echo "Finishing transcription (most of it was done during the meeting)..."
        waited_on_live=1
        local waited=0
        while kill -0 "$live_pid" 2>/dev/null && (( waited < 600 )); do
            sleep 2; waited=$((waited + 2))
        done
        kill "$live_pid" 2>/dev/null
    fi
    # trust the live transcript only if the worker finished (or we just waited for it)
    if [[ -s "$base.partial.txt" ]] && { [[ -f "$base.live.done" ]] || (( waited_on_live )); }; then
        mv "$base.partial.txt" "$base.txt"; used_live=1
    fi
    rm -f "$base.stop" "$base.live.done" "$base.partial.txt"

    if (( ! used_live )); then
        echo "Transcribing on this machine (model: $WHISPER_MODEL)..."
        "$PY" "$PREFIX/lib/transcribe.py" "$base.wav" "$base.txt" \
            "$WHISPER_MODEL" "$YOU_LABEL" "$THEM_LABEL" || true
    fi
    if [[ ! -s "$base.txt" ]]; then
        # Say which side was silent rather than printing a log: a flat
        # microphone is a setup problem the person can actually act on.
        local diag; diag=$("$PY" "$PREFIX/lib/transcribe.py" --levels "$base.wav" 2>/dev/null)
        echo "No speech was recognised in this recording." >&2
        [[ -n "$diag" ]] && echo "$diag" >&2
        echo "The audio is kept at $base.wav if you want to try again." >&2
        touch "$base.nospeech"; rm -f "$base.job"
        return 1
    fi

    _voice_prefixes; _split_voices "$base.wav" "$base.txt" "$THEM_LABEL" "$_p_part"
    if cmd_notes "$base.txt" "$title" "$mins"; then rm -f "$base.job"; else return 1; fi
}

cmd_finish() { [[ -n "${1:-}" ]] || die "usage: meetinginsights finish <name>"; _finish_recording "$1"; }

cmd_notes() {
    local transcript="$1" title="${2:-meeting}" mins="${3:-?}"
    [[ -s "$transcript" ]] || die "empty transcript: $transcript"
    _meta_load "${transcript%.txt}"; _meta_env
    check_ready
    mkdir -p "$OUT_DIR"
    local out="$OUT_DIR/$(basename "${transcript%.txt}").md"

    echo "Writing notes on this machine ($(basename "$LLM_MODEL"))..."
    if MEETINGINSIGHTS_LLAMA_DIR="$(dirname "$LLAMA")" \
       "$PY" "$PREFIX/lib/notes_local.py" "$transcript" "$out" "$LLM_MODEL" "$title" "$mins" \
         >"$DATA_DIR/.last_notes.log" 2>&1 && [[ -s "$out" ]]; then
        echo "Notes: $out"
        echo "Transcript: $transcript"
        return 0
    fi
    echo "Note generation failed; see $DATA_DIR/.last_notes.log" >&2
    echo "The transcript is still available: $transcript" >&2
    return 1
}

CONFIG_KEYS="whisper_model notes_model notes_provider whisper_device diarize speakers prompt beam threads normalize"
cmd_config() {
    local key="${1:-}"; shift || true
    local val="$*"
    if [[ -z "$key" ]]; then
        echo "whisper_model=$WHISPER_MODEL"
        echo "notes_model=$MEETINGINSIGHTS_NOTES_MODEL"
        echo "notes_provider=$MEETINGINSIGHTS_NOTES_PROVIDER"
        echo "whisper_device=$MEETINGINSIGHTS_DEVICE"
        echo "diarize=$MEETINGINSIGHTS_DIARIZE"
        echo "speakers=$MEETINGINSIGHTS_SPEAKERS"
        echo "beam=$MEETINGINSIGHTS_BEAM"
        echo "threads=$MEETINGINSIGHTS_THREADS"
        echo "normalize=$MEETINGINSIGHTS_NORMALIZE"
        echo "prompt=$MEETINGINSIGHTS_PROMPT"
        return 0
    fi
    [[ " $CONFIG_KEYS " == *" $key "* ]] || die "unknown setting: $key ($CONFIG_KEYS)"
    if [[ $# -eq 0 && -z "$val" ]]; then cfg_get "$key" ""; return 0; fi
    case "$key" in
        notes_model)    [[ "$val" =~ ^(small|medium)$ ]] || die "notes_model must be small or medium" ;;
        notes_provider) [[ "$val" =~ ^(local|claude-code|gemini-cli)$ ]] || die "notes_provider must be local, claude-code or gemini-cli" ;;
        whisper_model)  [[ "$val" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid model name: $val" ;;
        whisper_device) [[ "$val" =~ ^(auto|cpu)$ ]] || die "whisper_device must be auto or cpu" ;;
        diarize|normalize) [[ "$val" =~ ^(on|off)$ ]] || die "$key must be on or off" ;;
        speakers)       [[ "$val" =~ ^[0-8]$ ]] || die "speakers must be 0 (automatic) to 8" ;;
        beam)           [[ "$val" =~ ^([1-9]|10)$ ]] || die "beam must be 1 to 10" ;;
        threads)        [[ "$val" =~ ^[0-9]{1,2}$ ]] || die "threads must be 0 (automatic) to 99" ;;
        prompt)         val="$(echo "$val" | tr '\n\r' '  ' | cut -c1-500)" ;;
    esac
    mkdir -p "$(dirname "$CONFIG_FILE")"
    touch "$CONFIG_FILE"
    sed -i "/^$key=/d" "$CONFIG_FILE"
    [[ -n "$val" ]] && echo "$key=$val" >> "$CONFIG_FILE"
    echo "$key=$val"
}

cmd_providers() { # prints the external note writers that are installed
    "${PY:-python3}" - "$PREFIX/lib" <<'PYEOF'
import sys
sys.path.insert(0, sys.argv[1])
import notes_external as n
for p in ("claude-code", "gemini-cli"):
    if n.available(p):
        print(p)
PYEOF
}

cmd_language() {
    if [[ $# -eq 0 ]]; then
        echo "setting: $(head -n1 "$LANG_FILE" 2>/dev/null || echo system)  (in use: $MEETINGINSIGHTS_LANGUAGE)"
        return 0
    fi
    [[ "$1" =~ ^(system|auto|[a-z]{2,3})$ ]] || die "invalid language: $1 (use system, auto, or a code like pt, en)"
    mkdir -p "$(dirname "$LANG_FILE")" && echo "$1" > "$LANG_FILE"
    echo "language set to: $1"
}

# --- per-meeting actions: <name> is the file stem, e.g. 2026-11-09_14-36_meeting ---
_valid_name() {
    [[ -n "$1" && "$1" != */* && "$1" != *..* ]] || die "invalid name: ${1:-<empty>}"
    [[ -e "$OUT_DIR/$1.md" || -e "$DATA_DIR/rec/$1.wav" || -e "$DATA_DIR/rec/$1.txt" ]] || die "no such meeting: $1"
}

_meeting_title() {
    local t; t=$(sed -n '1s/^# //p' "$OUT_DIR/$1.md" 2>/dev/null)
    echo "${t:-meeting}"
}

cmd_reprocess() {
    _parse_meta_flags "$@"
    local name="${POS[0]:-}" mode="${POS[1]:-}" nc="$M_CLIENT" nf="$M_FOCUS" sc="$M_CLIENT_SET" sf="$M_FOCUS_SET"
    _valid_name "$name"
    local base="$DATA_DIR/rec/$name" title mins d
    _meta_load "$base"
    (( sc )) && M_CLIENT="$nc"; (( sf )) && M_FOCUS="$nf"
    _meta_save "$base"; _meta_env
    title=$(_meeting_title "$name")
    if [[ "$mode" != "--notes-only" ]]; then
        [[ -s "$base.wav" ]] || die "the audio for this meeting was not kept: $base.wav"
        echo "Transcribing again (model: $WHISPER_MODEL, language: $MEETINGINSIGHTS_LANGUAGE)..."
        "$PY" "$PREFIX/lib/transcribe.py" "$base.wav" "$base.txt.new" \
            "$WHISPER_MODEL" "$YOU_LABEL" "$THEM_LABEL" || true
        [[ -s "$base.txt.new" ]] || { rm -f "$base.txt.new"; die "no speech was recognised; the old transcript was kept"; }
        mv -f "$base.txt.new" "$base.txt"
        _voice_prefixes; _split_voices "$base.wav" "$base.txt" "$THEM_LABEL" "$_p_part"
    fi
    d=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$base.wav" 2>/dev/null)
    mins=$(awk -v d="${d:-0}" 'BEGIN{printf "%d", d/60}')
    cmd_notes "$base.txt" "$title" "$mins"
}

cmd_rename() {
    local name="${1:-}" new="${2:-}"
    _valid_name "$name"
    [[ -n "$new" ]] || die "usage: meetinginsights rename <name> <new title>"
    local slug prefix newname
    slug=$(echo "$new" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')
    slug="${slug:-meeting}"
    prefix=$(echo "$name" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}_' || true)
    newname="${prefix}${slug}"
    if [[ "$newname" != "$name" && ( -e "$OUT_DIR/$newname.md" || -e "$DATA_DIR/rec/$newname.wav" ) ]]; then
        die "a meeting named $newname already exists"
    fi
    if [[ -f "$OUT_DIR/$name.md" ]]; then
        # replace the heading only on the first line
        sed -i "1s|^# .*|# ${new//|/\\|}|" "$OUT_DIR/$name.md"
    fi
    if [[ "$newname" != "$name" ]]; then
        [[ -f "$OUT_DIR/$name.md" ]] && mv -n "$OUT_DIR/$name.md" "$OUT_DIR/$newname.md"
        local ext
        for ext in txt wav meta nospeech; do
            [[ -f "$DATA_DIR/rec/$name.$ext" ]] && mv -n "$DATA_DIR/rec/$name.$ext" "$DATA_DIR/rec/$newname.$ext"
        done
    fi
    echo "Renamed to: $newname"
}

cmd_import() {
    _parse_meta_flags "$@"
    local file="${POS[0]:-}" title="${POS[1]:-}"
    [[ -f "$file" ]] || die "usage: meetinginsights import <audio-or-video-file> [title]"
    need ffmpeg; check_ready
    [[ -n "$title" ]] || title="$(basename "${file%.*}")"
    local slug ts base
    slug=$(echo "$title" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')
    ts=$(date +%Y-%m-%d_%H-%M)
    base="$DATA_DIR/rec/${ts}_${slug:-meeting}"
    mkdir -p "$DATA_DIR/rec" "$OUT_DIR"
    chmod 700 "$DATA_DIR" "$DATA_DIR/rec" "$OUT_DIR" 2>/dev/null || true
    _meta_save "$base"; _meta_env
    echo "Converting the audio..."
    ffmpeg -loglevel error -y -i "$file" -vn -ac 1 -ar 16000 "$base.wav" 2>&1 | tail -2
    [[ -s "$base.wav" ]] || die "could not read audio from: $file"
    echo "Transcribing on this machine (model: $WHISPER_MODEL)..."
    "$PY" "$PREFIX/lib/transcribe.py" "$base.wav" "$base.txt" "$WHISPER_MODEL" "$YOU_LABEL" "$THEM_LABEL" || true
    if [[ ! -s "$base.txt" ]]; then
        echo "No speech was recognised in this file." >&2
        rm -f "$base.wav"; return 1
    fi
    local d mins
    d=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$base.wav" 2>/dev/null)
    mins=$(awk -v d="${d:-0}" 'BEGIN{printf "%d", d/60}')
    _voice_prefixes; _split_voices "$base.wav" "$base.txt" "Speaker" "$_p_spk"
    cmd_notes "$base.txt" "$title" "$mins"
}

cmd_export() {
    local name="${1:-}" fmt="${2:-}" dest="" flag=""
    shift 2 2>/dev/null || true
    for a in "$@"; do [[ "$a" == "--no-transcript" ]] && flag="--no-transcript" || dest="$a"; done
    _valid_name "$name"
    [[ "$fmt" =~ ^(md|docx|pdf)$ ]] || die "usage: meetinginsights export <name> <md|docx|pdf> [file] [--no-transcript]"
    [[ -n "$dest" ]] || dest="$OUT_DIR/exports/$name.$fmt"
    "$PY" -c 'import docx, reportlab' 2>/dev/null || {
        echo "Installing the export libraries..." >&2
        "$DATA_DIR/venv/bin/pip" install -q python-docx reportlab >/dev/null 2>&1 \
            || die "could not install python-docx and reportlab"
    }
    local lang=en
    case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in pt*) lang=pt ;; esac
    local txt="$DATA_DIR/rec/$name.txt"; [[ -f "$txt" ]] || txt="-"
    "$PY" "$PREFIX/lib/export.py" "$OUT_DIR/$name.md" "$txt" "$dest" --lang "$lang" $flag
}

cmd_delete() {
    local name="${1:-}"
    _valid_name "$name"
    if [[ -f "$STATE" ]] && [[ "$(head -n1 "$STATE")" == "$DATA_DIR/rec/$name" ]]; then
        die "this meeting is being recorded right now"
    fi
    rm -f -- "$OUT_DIR/$name.md" "$DATA_DIR/rec/$name.txt" "$DATA_DIR/rec/$name.wav" "$DATA_DIR/rec/$name.meta" "$DATA_DIR/rec/$name.nospeech"
    echo "Deleted: $name"
}

case "${1:-}" in
    start)  shift; cmd_start "$@" ;;
    stop)   shift; cmd_stop "$@" ;;
    status) cmd_status ;;
    ready)  cmd_ready ;;
    setup)  shift; cmd_setup "$@" ;;
    reprocess) shift; cmd_reprocess "$@" ;;
    rename) shift; cmd_rename "$@" ;;
    export) shift; cmd_export "$@" ;;
    import) shift; cmd_import "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    finish) shift; cmd_finish "$@" ;;
    recover) shift; cmd_recover "$@" ;;
    client) shift; cmd_client "$@" ;;
    providers) cmd_providers ;;
    config) shift; cmd_config "$@" ;;
    language) shift; cmd_language "$@" ;;
    notes)  shift; [[ $# -ge 1 ]] || die "usage: meetinginsights notes <transcript.txt>"; cmd_notes "$@" ;;
    -h|--help|help|"") sed -n "3,27p" "$0" | sed 's/^# \?//' ;;
    *) die "unknown command: $1 (try: meetinginsights help)" ;;
esac
